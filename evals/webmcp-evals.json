[
  {
    "name": "Discover the current workflow before answering",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Inspect the workflow and tell me what is currently on the canvas."
      }
    ],
    "expectedCall": [
      {
        "functionName": "discover_workflow",
        "arguments": {}
      }
    ]
  },
  {
    "name": "Inspect Enrich company relationships",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "What is connected immediately after Enrich company? Inspect the workflow rather than guessing."
      }
    ],
    "expectedCall": [
      {
        "functionName": "discover_workflow",
        "arguments": {}
      },
      {
        "functionName": "inspect_workflow_items",
        "arguments": {
          "objects": [
            {
              "kind": "workflow-node",
              "id": "enrich-company"
            }
          ]
        }
      }
    ]
  },
  {
    "name": "Recover leads from an unavailable enrichment service",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "We’ve had leads disappear whenever company enrichment is unavailable. Update the workflow so those leads are not lost and can be handled by the sales operations team. Show me what changed."
      }
    ],
    "expectedCall": [
      {
        "functionName": "discover_workflow",
        "arguments": {}
      },
      {
        "functionName": "edit_workflow",
        "arguments": {
          "baseRevision": 0,
          "commands": {
            "$type": "array"
          }
        }
      },
      {
        "functionName": "show_edit_result",
        "arguments": {
          "operationId": {
            "$type": "string"
          }
        },
        "optional": false
      }
    ]
  },
  {
    "name": "Focus the named Zoom In target",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Put keyboard focus on the Zoom In control."
      }
    ],
    "expectedCall": [
      {
        "functionName": "discover_workflow",
        "arguments": {}
      },
      {
        "functionName": "focus_page_element",
        "arguments": {
          "targetId": "canvas.zoom-in"
        }
      }
    ]
  },
  {
    "name": "Infer which step belongs to sales operations",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Show me the step owned by sales operations."
      }
    ],
    "expectedCall": [
      {
        "functionName": "discover_workflow",
        "arguments": {}
      },
      {
        "functionName": "show_workflow_item",
        "arguments": {
          "kind": "workflow-node",
          "id": "manual-review"
        }
      }
    ]
  }
]

                "position": { "x": 100, "y": 200 },
                "properties": {}
              }
            },
            {
              "type": "createNode",
              "node": {
                "id": "manual-review",
                "type": "action",
                "label": "Manual review",
                "position": { "x": 400, "y": 350 },
                "properties": {}
              }
            },
            {
              "type": "createNode",
              "node": {
                "id": "archive-request",

[
  {
    "name": "Discover the current workflow before answering",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Inspect the workflow and tell me what is currently on the canvas."
      }
    ],
    "expectedCall": [
      {
        "functionName": "discover_workflow",
        "arguments": {}
      }
    ]
  },
  {
    "name": "Inspect Enrich company relationships",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "What is connected immediately after Enrich company? Inspect the workflow rather than guessing."
      }
    ],
    "expectedCall": [
      {
        "functionName": "discover_workflow",
        "arguments": {}
      },
      {
        "functionName": "inspect_workflow_items",
        "arguments": {
          "objects": [
            {
              "kind": "workflow-node",
              "id": "enrich-company"
            }
          ]
        }
      }
    ]
  },
  {
    "name": "Insert an Action and surface the edit evidence",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Inspect the lead qualification workflow. Add an Action named Notify sales after Create CRM opportunity, reconnect it to Complete, then show me the edit result."
      }
    ],
    "expectedCall": [
      {
        "functionName": "discover_workflow",
        "arguments": {}
      },
      {
        "functionName": "edit_workflow",
        "arguments": {
          "baseRevision": 0,
          "commands": [
            {
              "type": "createNode",
              "node": {
                "id": "notify-sales",
                "type": "action",
                "label": "Notify sales",
                "position": {
                  "x": {
                    "$type": "number"
                  },
                  "y": {
                    "$type": "number"
                  }
                },
                "properties": {}
              }
            },
            {
              "type": "replaceConnection",
              "edgeId": "edge-opportunity-end",
              "replacement": [
                {
                  "id": "edge-opportunity-notify",
                  "source": "create-opportunity",
                  "sourcePort": "success",
                  "target": "notify-sales",
                  "targetPort": "input"
                },
                {
                  "id": "edge-notify-complete",
                  "source": "notify-sales",
                  "sourcePort": "success",
                  "target": "complete",
                  "targetPort": "input"
                }
              ]
            }
          ]
        }
      },
      {
        "functionName": "show_edit_result",
        "arguments": {
          "operationId": {
            "$type": "string"
          }
        },
        "optional": true
      }
    ]
  },
  {
    "name": "Focus the named Zoom In target",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Put keyboard focus on the Zoom In control."
      }
    ],
    "expectedCall": [
      {
        "functionName": "discover_workflow",
        "arguments": {}
      },
      {
        "functionName": "focus_page_element",
        "arguments": {
          "targetId": "canvas.zoom-in"
        }
      }
    ]
  },
  {
    "name": "Reveal an existing workflow node",
    "messages": [
      {
        "role": "user",
        "type": "message",
        "content": "Show me the Enrich company workflow node."
      }
    ],
    "expectedCall": [
      {
        "functionName": "discover_workflow",
        "arguments": {}
      },
      {
        "functionName": "show_workflow_item",
        "arguments": {
          "kind": "workflow-node",
          "id": "enrich-company"
        }
      }
    ]
  }
]

{
  "name": "workflow-receipts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "postinstall": "patch-package",
    "eval:browser": "node evals/runBrowserEvals.mjs",
    "eval:latency": "node evals/summarizeLatency.mjs",
    "eval:latency:check": "node evals/checkLatency.mjs",
    "eval:surface-bridge": "node evals/runSurfaceBridge.mjs",
    "build": "tsc -b && vite build && vite build --config vite.worker.config.ts",
    "test": "vitest run && node --test evals/*.node-test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@xyflow/react": "^12.8.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "patch-package": "8.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "webmcp-evals": "0.0.4"
  }
}
